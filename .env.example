# Supabase > Project settings > API. Only use the publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical application origin; required for authentication emails in production.
# Local development example: http://localhost:3000
APP_URL=

# Optional, test-only: two confirmed accounts in a dedicated test project.
# Never set these in Vercel or commit actual values.
STASH_TEST_EMAIL_A=
STASH_TEST_PASSWORD_A=
STASH_TEST_EMAIL_B=
STASH_TEST_PASSWORD_B=
